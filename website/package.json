{
  "name": "xenon-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node prepare.mjs && vitepress dev --host 127.0.0.1 --port 4178",
    "build": "node prepare.mjs && vitepress build",
    "preview": "node prepare.mjs && vitepress preview --host 127.0.0.1 --port 4178",
    "test:ui": "node tests/site-qa.mjs",
