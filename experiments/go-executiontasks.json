  "fault_schedule": "Declared lost completed DLQ put response; Add task batch inserts a fresh key before duplicate abort; deleted DLQ put replay after reopen; competing native writer fences old replay.",
  "assertions": [
    "Full pinned low-level ExecutionStore composes real components over one Go RPC connection.",
    "Pinned 15-test ExecutionMutableStateTaskSuite runs through actual gRPC using committed random seed.",
    "AddHistoryTasks guards shard range and atomically inserts all task categories with duplicate rollback.",
    "Replication DLQ first insert is immutable across duplicate puts, with exact int64 IDs and unknown protobuf fields preserved.",
    "Reads and range deletion honor [minimum,maximum); empty tail includes admitted MaxInt64.",
    "Byte-bounded pagination, source-cluster isolation, response loss/replay, reopen and fencing are asserted."
  ],
  "limitations": [
    "Memory object-store component proof; S3/process-crash, routing, Temporal boot and Omes remain separate gates.",
    "Upstream task suite is covered, not all workflow/history persistence suites.",
    "Request transport limit2MiB, page limit3MiB and bounded journal capacity remain explicit constraints."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-shard",
      "filter": "TestExecutionTasksRPC",
      "exact": true,
      "expected_tests": [
        "TestExecutionTasksRPC"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestExecutionTasksUpstream",
      "exact": true,
      "expected_tests": [
        "TestExecutionTasksUpstream",
        "TestExecutionTasksUpstream/TestAddGetCompleteImmediateTask_Single",
        "TestExecutionTasksUpstream/TestAddGetRangeCompleteImmediateTasks_Multiple",
        "TestExecutionTasksUpstream/TestAddGetCompleteScheduledTask_Single",
        "TestExecutionTasksUpstream/TestAddGetRangeCompleteScheduledTasks_Multiple",
        "TestExecutionTasksUpstream/TestAddGetCompleteTransferTask_Single",
        "TestExecutionTasksUpstream/TestAddGetTransferTasks_Multiple",
        "TestExecutionTasksUpstream/TestAddGetCompleteTimerTask_Single",
        "TestExecutionTasksUpstream/TestAddGetTimerTasks_Multiple",
        "TestExecutionTasksUpstream/TestAddGetCompleteReplicationTask_Single",
        "TestExecutionTasksUpstream/TestAddGetReplicationTasks_Multiple",
        "TestExecutionTasksUpstream/TestAddGetCompleteVisibilityTask_Single",
        "TestExecutionTasksUpstream/TestAddGetVisibilityTasks_Multiple",
        "TestExecutionTasksUpstream/TestIsReplicationDLQEmpty",
        "TestExecutionTasksUpstream/TestGetTimerTasksOrdered",
        "TestExecutionTasksUpstream/TestGetScheduledTasksOrdered"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerExecutionTasksRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerExecutionTasksRecovery"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerExecutionTasksBytePages",
      "exact": true,
