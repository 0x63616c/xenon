{
  "schema": 1,
  "name": "go-shard",
  "backend": "memory",
  "timeout_seconds_per_command": 600,
  "required_tool_prefixes": {
    "rustc": "rustc 1.94.0 ",
    "go": "go version go1.27.1 "
  },
  "inputs": [
    "test/compatibility/rust/Cargo.toml",
    "test/compatibility/rust/Cargo.lock",
    "rust-toolchain.toml",
    "go.mod",
    "go.sum",
    "proto/xenon/v1/persistence.proto",
    "gen/xenon/v1/persistence.pb.go",
    "gen/xenon/v1/persistence_grpc.pb.go",
    "internal/adapter/shard.go",
    "internal/adapter/shard_integration_test.go",
    "proof/shard/case.json",
    "scripts/generate-proto.sh",
    "scripts/test-shard.sh",
    "tools/protoc.json",
    "scripts/install-protoc.py",
    "scripts/test_prove.py",
    "tools/slatedb-native.json",
    "scripts/build-go-node.py",
    "internal/node/shard.go",
    "internal/node/shard_test.go",
    "cmd/xenon-go-node/main.go",
    "proof/go-shard/case.json",
    "proof/go-shard/README.md",
    ".github/workflows/ci.yaml",
    "proto/xenon/v1/metadata.proto",
    "gen/xenon/v1/metadata.pb.go",
    "gen/xenon/v1/metadata_grpc.pb.go",
    "internal/node/journal.go",
    "internal/node/metadata.go",
    "internal/persistence/cluster.go",
    "internal/persistence/cluster_service.go",
    "internal/persistence/cluster_test.go",
    "internal/persistence/execution.go",
    "internal/persistence/execution_service.go",
    "internal/persistence/execution_test.go",
    "internal/persistence/executiontasks.go",
    "internal/persistence/executiontasks_service.go",
    "internal/persistence/history.go",
    "internal/persistence/history_service.go",
    "internal/persistence/history_test.go",
    "internal/persistence/historytasks.go",
    "internal/persistence/historytasks_service.go",
    "internal/persistence/matching.go",
    "internal/persistence/matching_fair.go",
    "internal/persistence/matching_scan.go",
    "internal/persistence/matching_service.go",
    "internal/persistence/matching_test.go",
    "internal/persistence/matching_userdata.go",
    "internal/persistence/metadata.go",
    "internal/persistence/metadata_service.go",
    "internal/persistence/metadata_test.go",
    "internal/persistence/nexus.go",
    "internal/persistence/nexus_service.go",
    "internal/persistence/nexus_test.go",
    "internal/persistence/queue.go",
    "internal/persistence/queue_service.go",
    "internal/persistence/queue_test.go",
    "internal/persistence/queuev2.go",
    "internal/persistence/queuev2_service.go",
    "internal/persistence/queuev2_test.go",
    "internal/persistence/service.go",
    "internal/persistence/service_test.go",
    "internal/persistence/shard.go",
    "internal/persistence/tasks_test.go",
    "internal/persistence/visibility.go",
    "internal/persistence/visibility_service.go",
    "internal/persistence/visibility_test.go",
    "internal/partitions/engine.go",
    "internal/cluster/layout.go"
  ],
  "fault_schedule": "case.json drop_first_completed_update_response; Go native stalled WAL flush and competing writer tests use committed deterministic transitions.",
  "assertions": [
    "Exact Go ShardStore payload/encoding and callback semantics cross real gRPC into the Go owner with official SlateDB native bindings.",
    "Lost completed response retries same operation identity and does not overwrite intervening state.",
    "Shard and outcomes reopen together; replay cannot bypass writer fencing.",
    "Missing Update and range mismatch preserve distinct typed errors.",
    "Stalled durability quarantines; caller timeout and admission are bounded.",
    "All integration fixtures execute only the freshly built Go owner; no Rust server fallback."
  ],
  "limitations": [
    "Single logical partition; no directory/routing/full Temporal boot.",
    "Memory object store only; no real-S3 or process-crash recovery claim.",
    "Native registered proof; pinned container orchestration remains a separate shipping gate."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerRecoveryAndReplay",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerRecoveryAndReplay"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerFencedReplay",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerFencedReplay"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerNativeTimeout",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerNativeTimeout"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerPausedAdmission",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerPausedAdmission"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestShardRPC",
      "exact": true,
      "expected_tests": [
        "TestShardRPC"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestShardTransportBoundsAndTypes",
      "exact": true,
      "expected_tests": [
        "TestShardTransportBoundsAndTypes",
        "TestShardTransportBoundsAndTypes/Unavailable",
        "TestShardTransportBoundsAndTypes/ResourceExhausted",
        "TestShardTransportBoundsAndTypes/InvalidArgument",
        "TestShardTransportBoundsAndTypes/OK"
      ]
    }
  ]
}
