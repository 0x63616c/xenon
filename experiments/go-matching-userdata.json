{
  "schema": 1,
  "name": "go-matching-userdata",
  "backend": "memory",
  "timeout_seconds_per_command": 600,
  "required_tool_prefixes": {
    "rustc": "rustc 1.94.0 ",
    "go": "go version go1.27.1 "
  },
  "inputs": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "go.mod",
    "go.sum",
    "proto/xenon/v1/persistence.proto",
    "gen/xenon/v1/persistence.pb.go",
    "gen/xenon/v1/persistence_grpc.pb.go",
    "internal/adapter/shard.go",
    "internal/adapter/shard_integration_test.go",
    "proof/shard/case.json",
    "scripts/generate-proto.sh",
    "scripts/test-shard.sh",
    "tools/protoc.json",
    "scripts/install-protoc.py",
    "scripts/test_prove.py",
    "tools/slatedb-native.json",
    "scripts/build-go-node.py",
    "internal/node/shard.go",
    "internal/node/shard_test.go",
    "cmd/xenon-go-node/main.go",
    "proof/go-shard/case.json",
    "proto/xenon/v1/metadata.proto",
    "gen/xenon/v1/metadata.pb.go",
    "gen/xenon/v1/metadata_grpc.pb.go",
    "internal/node/journal.go",
    "internal/node/metadata.go",
    "internal/adapter/metadata.go",
    "internal/adapter/metadata_integration_test.go",
    "proof/namespace/case.json",
    "internal/node/metadata_test.go",
    "proto/xenon/v1/cluster.proto",
    "gen/xenon/v1/cluster.pb.go",
    "gen/xenon/v1/cluster_grpc.pb.go",
    "internal/node/cluster.go",
    "internal/node/cluster_test.go",
    "internal/adapter/cluster.go",
    "internal/adapter/cluster_test.go",
    "proof/go-cluster/case.json",
    "proof/go-cluster/README.md",
    ".github/workflows/ci.yaml",
    "proto/xenon/v1/matching.proto",
    "gen/xenon/v1/matching.pb.go",
    "gen/xenon/v1/matching_grpc.pb.go",
    "internal/node/matching.go",
    "internal/node/matching_test.go",
    "internal/adapter/matching.go",
    "proof/go-matching/case.json",
    "proof/go-matching/README.md",
    "internal/node/matching_userdata.go",
    "internal/node/matching_userdata_test.go",
    "proof/go-matching/userdata.json",
    "proof/go-matching/USERDATA.md"
  ],
  "fault_schedule": "proof/go-matching/case.json and userdata.json: batch version conflict, duplicate mapping rollback, apply/conflict pointer restoration, opaque pages, reopen replay; pinned upstream suite workloads.",
  "assertions": [
    "Eight legacy matching queue/tasks operations cross real Go adapter gRPC into the official native SlateDB owner.",
    "Stale range and duplicate batches leave no partial writes across subqueues.",
    "Sorted bounded task pages, completion limits, and byte-bounded queue/task pages preserve blobs.",
    "Completed-response retry and reopened outcome replay preserve state and identity.",
    "Full pinned legacy TaskStore satisfies upstream TaskQueue, TaskQueueTask and TaskQueueUserData suites over actual gRPC.",
    "Namespace batches atomically update user-data versions and build-ID mappings; pointer Applied/Conflicting outputs survive typed transport.",
    "Conflict and duplicate mapping rollback preserve both data and indexes; durable replay/reopen cannot repeat prior mutation.",
    "User-data near-limit pages preserve three complete blobs across byte-budget continuation."
  ],
  "limitations": [
    "Local memory object store only, no real S3/Temporal boot/FairTaskStore/distributed catalog proof.",
    "Blob1MiB, command1800KiB, batch/list1000, response3MiB ceilings remain; nonpaginated build-ID result fails explicitly above budget.",
    "Upstream suites generate randomized UUIDs/task IDs in pinned code; workload shape fixed, not byte-identical generated inputs. Custom fault fixtures use committed IDs.",
    "Upstream conformance helper uses declared1ms WAL flush for1024durable one-row reads inside upstream30s deadline. Production default remains100ms; every operation still awaits durability."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingRPC",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingRPC"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingRecovery"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingBytePages",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingBytePages"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingUserData",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingUserData"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingUserDataRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingUserDataRecovery"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingUserDataBytePages",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingUserDataBytePages"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingUpstreamUserData",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingUpstreamUserData",
        "TestGoOwnerMatchingUpstreamUserData/TestSetInitialAndIncrement",
        "TestGoOwnerMatchingUpstreamUserData/TestUpdateConflict"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingUpstreamQueues",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingUpstreamQueues",
        "TestGoOwnerMatchingUpstreamQueues/TestCreate_Normal",
        "TestGoOwnerMatchingUpstreamQueues/TestCreate_Sticky",
        "TestGoOwnerMatchingUpstreamQueues/TestCreate_Normal_Dup",
        "TestGoOwnerMatchingUpstreamQueues/TestCreate_Sticky_Dup",
        "TestGoOwnerMatchingUpstreamQueues/TestUpdate_Normal",
        "TestGoOwnerMatchingUpstreamQueues/TestUpdate_Normal_Conflict",
        "TestGoOwnerMatchingUpstreamQueues/TestUpdate_Sticky",
        "TestGoOwnerMatchingUpstreamQueues/TestUpdate_Sticky_Conflict",
        "TestGoOwnerMatchingUpstreamQueues/TestDelete",
        "TestGoOwnerMatchingUpstreamQueues/TestDelete_Conflict"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingUpstreamTasks",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingUpstreamTasks",
        "TestGoOwnerMatchingUpstreamTasks/TestCreateGet_Conflict",
        "TestGoOwnerMatchingUpstreamTasks/TestCreateGet_One",
        "TestGoOwnerMatchingUpstreamTasks/TestCreateGet_Multiple",
        "TestGoOwnerMatchingUpstreamTasks/TestCreateDelete_Multiple"
      ]
    }
  ]
}
