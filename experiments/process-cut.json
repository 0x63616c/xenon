  "fault_schedule": "exact configured shard UPDATE, explicitly arm fresh process incarnation/session, observe selected live Commit/Await/publication barrier, externally SIGKILL exact PID; fresh native raw state/journal/count oracle before exact-ID retry",
  "assertions": [
    "Default-off exact mutation selection, stale arm rejection and one-shot stage consumption.",
    "Timed-out barrier quarantines before releasing gate; actual stalled AwaitDurable retains native handle/worker until WAL flush drains.",
    "All three real SIGKILL stages observed; no successful RPC response, atomic durable state/journal/count, and successful exact retry after fresh native inspection."
  ],
  "limitations": [
    "Direct shard mutation component only; runtime Temporal operation-ID/digest discovery before dispatch remains separate.",
    "Pre-Await may already be durable; recovery allows wholly old or wholly new state, never partial.",
    "Pinned MinIO only; other fault families, full workload and real S3 remain separate gates."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-process-cut",
      "filter": "TestCutIdentityAndOneShot",
      "exact": true,
      "expected_tests": [
        "TestCutIdentityAndOneShot"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerProcessCutTimeout",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerProcessCutTimeout",
        "TestGoOwnerProcessCutTimeout/commit_before_await",
        "TestGoOwnerProcessCutTimeout/after_await",
        "TestGoOwnerProcessCutTimeout/before_result_publication"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerProcessCutRetainsNativeWait",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerProcessCutRetainsNativeWait"
      ]
    },
    {
      "runner": "s3-process-cut",
      "filter": "TestS3ProcessCuts",
      "exact": true,
      "expected_tests": [
        "TestS3ProcessCuts",
        "TestS3ProcessCuts/commit_before_await",
        "TestS3ProcessCuts/after_await",
        "TestS3ProcessCuts/before_result_publication"
      ]
    }
  ]
