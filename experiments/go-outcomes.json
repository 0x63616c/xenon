  "fault_schedule": "Fill the configured journal, reject new IDs, replay at capacity, reopen; stop a workflow after durable history prewrite consumes final slot, reopen with prospectively explicit increased test cap and retry same root identity.",
  "assertions": [
    "New reads and logical outcomes consume capacity; replay at capacity preserves original result.",
    "Durable per-family counts and encoded StoredOutcome byte totals match exact retained values through reopen.",
    "Prewrite suboperations count independently and resume without duplicate accounting.",
    "Legacy unaccounted entries are explicit and never falsely declared complete.",
    "Manager propagates explicit cap; metrics scrapes do not increment local persistence dispatch counters."
  ],
  "limitations": [
    "No deletion or expiry; this is bounded-proof capacity management, not indefinite production retention.",
    "Encoded outcome bytes exclude keys, indexes, WAL/SST versions, compaction and storage overhead.",
    "Legacy rows written by older binaries have unaccounted bytes and fail fresh proof completeness.",
    "Memory-component test; actual S3 manager movement remains a separate owner-manager gate."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerOutcomeCapacity",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerOutcomeCapacity"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerOutcomeLegacy",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerOutcomeLegacy"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerOutcomePrewriteCapacity",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerOutcomePrewriteCapacity"
      ]
    },
    {
      "runner": "go-test-outcomes",
      "filter": "TestOutcomeMetrics",
      "exact": true,
      "expected_tests": [
        "TestOutcomeMetrics"
      ]
    }
  ]
