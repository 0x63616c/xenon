  "fault_schedule": "Committed32overwrites and explicit memtable flushes, protected snapshot, observed compaction/GC, snapshot release, unflushed durable WAL update, competing writer, fence retention and reopen.",
  "assertions": [
    "Actual native completed compaction and nonzero WAL/manifest/obsolete-SST GC counters are corroborated by observed S3 object disappearance.",
    "Snapshot data remains stable during maintenance; obsolete SST collection progresses after snapshot release.",
    "WAL fences remain after accelerated GC age, old writer is rejected, acknowledged WAL-only update and replay survive fresh handles."
  ],
  "limitations": [
    "Pinned MinIO and accelerated declared engine settings, not real S3 or production-default elapsed-time proof.",
    "No local disk cache is configured; reopening creates fresh native handles over S3. Process-kill composition remains a separate requirement.",
    "This is bounded engine maintenance proof, not complete Temporal workload/Omes or application outcome journal retention proof."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "s3-maintenance",
      "filter": "TestS3Maintenance",
      "exact": true,
      "expected_tests": [
        "TestS3Maintenance"
      ]
    }
  ]
