  "fault_schedule": "Real upstream QueueV2 suite over gRPC with first completed enqueue response dropped. Fixed recovery fixture reopens after logical deletion, replays enqueue/range delete, rejects stale cursor sentinel exposure and fenced replay. Terminal allocation seeded at MaxInt64-1.",
  "assertions": [
    "Pinned upstream QueueV2 and HistoryTaskQueueManager interface suites pass over real gRPC.",
    "Range-delete metadata and messages commit atomically; replay preserves subsequent enqueue.",
    "Pages obey full3MiB wire budget and exact protobuf continuation format.",
    "Terminal and stale cursors cannot wrap or resurrect logically deleted sentinel."
  ],
  "limitations": [
    "Single logical partition; no directory/routing/full Temporal boot.",
    "Memory object store only; no real-S3 or process-crash recovery claim.",
    "Native registered proof; pinned container orchestration remains a separate shipping gate."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerQueueV2Upstream",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerQueueV2Upstream",
