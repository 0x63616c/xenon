{
  "schema": 1,
  "name": "go-fair",
  "backend": "memory",
  "timeout_seconds_per_command": 600,
  "required_tool_prefixes": {
    "rustc": "rustc 1.94.0 ",
    "go": "go version go1.27.1 "
  },
  "inputs": [
    "test/compatibility/rust/Cargo.toml",
    "test/compatibility/rust/Cargo.lock",
    "rust-toolchain.toml",
    "go.mod",
    "go.sum",
    "proto/xenon/v1/persistence.proto",
    "gen/xenon/v1/persistence.pb.go",
    "gen/xenon/v1/persistence_grpc.pb.go",
    "internal/adapter/shard.go",
    "internal/adapter/shard_integration_test.go",
    "proof/shard/case.json",
    "scripts/generate-proto.sh",
    "scripts/test-shard.sh",
    "tools/protoc.json",
    "scripts/install-protoc.py",
    "scripts/test_prove.py",
    "tools/slatedb-native.json",
    "scripts/build-go-node.py",
    "internal/node/shard.go",
    "internal/node/shard_test.go",
    "cmd/xenon-go-node/main.go",
    "proof/go-shard/case.json",
    "proto/xenon/v1/metadata.proto",
    "gen/xenon/v1/metadata.pb.go",
    "gen/xenon/v1/metadata_grpc.pb.go",
    "internal/node/journal.go",
    "internal/node/metadata.go",
    "internal/adapter/metadata.go",
    "internal/adapter/metadata_integration_test.go",
    "proof/namespace/case.json",
    "internal/node/metadata_test.go",
    "proto/xenon/v1/cluster.proto",
    "gen/xenon/v1/cluster.pb.go",
    "gen/xenon/v1/cluster_grpc.pb.go",
    "internal/node/cluster.go",
    "internal/node/cluster_test.go",
    "internal/adapter/cluster.go",
    "internal/adapter/cluster_test.go",
    "proof/go-cluster/case.json",
    "proof/go-cluster/README.md",
    ".github/workflows/ci.yaml",
    "proto/xenon/v1/matching.proto",
    "gen/xenon/v1/matching.pb.go",
    "gen/xenon/v1/matching_grpc.pb.go",
    "internal/node/matching.go",
    "internal/node/matching_test.go",
    "internal/adapter/matching.go",
    "proof/go-matching/case.json",
    "proof/go-matching/README.md",
    "internal/node/matching_userdata.go",
    "internal/node/matching_userdata_test.go",
    "proof/go-matching/userdata.json",
    "proof/go-matching/USERDATA.md",
    "internal/node/matching_fair.go",
    "internal/node/matching_fair_test.go",
    "docs/research/fair-matching-contract.md"
  ],
  "fault_schedule": "Committed fair recovery sequence: protocol downgrade rejection, separate legacy/fair queues, one-row tuple pages, bounded delete, reopen replay, competing writer.",
  "assertions": [
    "Fair matching uses protocol2 and isolated fair queue/task keys while sharing namespace user data.",
    "Pinned fair task and queue suites execute through gRPC into official native SlateDB.",
    "Tuple cursors preserve MaxInt64 task IDs and delete limits affect exact pass/id keys only.",
    "Reopen replay cannot reinsert deleted tasks; competing native writer fences the prior owner."
  ],
  "limitations": [
    "Memory object store proof only; no S3 or Temporal boot claim.",
    "Pinned upstream randomized task inputs have reproducible workload shape, not identical random bytes.",
    "Upstream fixture uses declared 1ms WAL flush; production remains 100ms."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerFairUpstreamTasks",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerFairUpstreamTasks",
        "TestGoOwnerFairUpstreamTasks/TestCreateGet_Order",
        "TestGoOwnerFairUpstreamTasks/TestCreateDelete_Range"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerFairUpstreamQueues",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerFairUpstreamQueues",
        "TestGoOwnerFairUpstreamQueues/TestCreate_Normal",
        "TestGoOwnerFairUpstreamQueues/TestCreate_Sticky",
        "TestGoOwnerFairUpstreamQueues/TestCreate_Normal_Dup",
        "TestGoOwnerFairUpstreamQueues/TestCreate_Sticky_Dup",
        "TestGoOwnerFairUpstreamQueues/TestUpdate_Normal",
        "TestGoOwnerFairUpstreamQueues/TestUpdate_Normal_Conflict",
        "TestGoOwnerFairUpstreamQueues/TestUpdate_Sticky",
        "TestGoOwnerFairUpstreamQueues/TestUpdate_Sticky_Conflict",
        "TestGoOwnerFairUpstreamQueues/TestDelete",
        "TestGoOwnerFairUpstreamQueues/TestDelete_Conflict"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerFairRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerFairRecovery"
      ]
    }
  ]
}
