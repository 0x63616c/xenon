  "fault_schedule": "No injected faults or ownership movement: five in-process real native owners (four visibility partitions plus schema/control) behind actual loopback gRPC; declared 1ms WAL flush.",
  "assertions": [
    "All 2000 deterministic records are written and populate all four fixed visibility partitions.",
    "Page sizes 1, 7 and 100 each enumerate the exact 2000 unique RunIDs without duplicates or omissions.",
    "Count equals 2000 and four ExecutionStatus groups each contain exactly 500 records.",
    "Three 1.1MB memos force byte-limited underfilled global pages at page sizes 7 and 100."
  ],
  "limitations": [
    "Frozen memory-object-store native component fixture only; no managed ownership movement, process kills, S3 or Temporal/Omes/UI proof.",
    "The 1ms WAL flush is a committed test setting, not production performance evidence; adapter per-call deadline remains 30 seconds.",
    "Concurrent mutation, full type/CHASM semantics and movement/runtime acceptance remain separate required gates."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerVisibilityFrozen",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerVisibilityFrozen"
      ]
    }
  ]
