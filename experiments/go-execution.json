  "fault_schedule": "Proxy drops the first completed workflow Create response; native duplicate task after a staged insert aborts current/state/tasks, history prewrites survive subsequent state conflict, then reopen and fence replay.",
  "assertions": [
    "Nine mutable-state methods cross actual gRPC to the Go native owner.",
    "Current-run, shard-range and DB version/legacy NextEventID guards preserve typed errors.",
    "Current pointer, state maps and generated tasks commit or roll back together.",
    "Prewritten history survives state conflict, and completed root replay never replays prewrites.",
    "Reopen retains acknowledged outcomes; a competing writer fences stale replay.",
    "Scheduled task keys and values use PostgreSQL microsecond precision including preepoch times."
  ],
  "limitations": [
    "Memory object store proof, not S3 or process-crash acceptance.",
    "Workflow mutable-state component only; task retrieval/completion and complete ExecutionStore factory remain separate gates.",
    "Configured partition only; routing and global scan fanout remain pending.",
    "2 MiB image limit and 3 MiB response limit are explicit bounded baseline ceilings."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-shard",
      "filter": "TestExecutionRPC",
      "exact": true,
      "expected_tests": [
        "TestExecutionRPC"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerExecutionRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerExecutionRecovery"
      ]
    }
  ]
}
