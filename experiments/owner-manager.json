  "assertions": [
    "Any-node opaque shard operation replay across explicit topology moves.",
    "Exact activated process incarnation prevents same-member reacquisition.",
    "Captured stale reads cannot pass durable authority barrier after fence.",
    "Two finite delayed native openers cannot serve and desired owner recovers."
  ],
  "limitations": [
    "MinIO only, no real AWS claim.",
    "Explicit administrative activation/reassignment, no automatic failure detection or balancing.",
    "Component RPC proof, no full Temporal/Omes acceptance."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "s3-owner-manager",
      "filter": "TestS3OwnerManager",
      "exact": true,
      "expected_tests": [
        "TestS3OwnerManager",
        "TestManagedServiceCoverage"
      ]
    }
  ]
