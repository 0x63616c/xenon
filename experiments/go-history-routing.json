  "fault_schedule": "Mutate caller configuration after construction; resume token against reordered list; exhaust an empty partition and cancel downstream fanout under one fixed invocation deadline.",
  "assertions": [
    "Four real native owners receive stable modulo shard placement through actual gRPC.",
    "Task insertion/read/completion colocate with shard range ownership.",
    "Global branch listing visits nonempty partitions and skips empty exhausted partitions with no static duplicates/omissions.",
    "Whole page remains within one local 3MiB result and may underfill the requested count.",
    "Changed partition configuration invalidates cursors; external list mutation cannot reinterpret existing stores.",
    "Empty-partition fanout retains one exact invocation deadline and stops on error."
  ],
  "limitations": [
    "Memory-object-store component proof; process ownership movement is a separate owner-manager proof.",
    "Fixed partition count and ordered names are immutable; changing them requires explicit data migration.",
    "Global listing is a live partition-ordered scan, not a distributed snapshot."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerHistoryPartitions",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerHistoryPartitions"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerTemporalFactory",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerTemporalFactory"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestHistoryPartitionDeadline",
      "exact": true,
      "expected_tests": [
        "TestHistoryPartitionDeadline"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestHistoryPartitionInvalidCursor",
      "exact": true,
      "expected_tests": [
        "TestHistoryPartitionInvalidCursor"
      ]
    }
  ]
