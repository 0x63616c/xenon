  "fault_schedule": "proof/go-matching/case.json; deterministic completed-response loss, stale and duplicate batch rollback, subqueue pages/completion, reopened outcome replay.",
  "assertions": [
    "Eight legacy matching queue/tasks operations cross real Go adapter gRPC into the official native SlateDB owner.",
    "Stale range and duplicate batches leave no partial writes across subqueues.",
    "Sorted bounded task pages, completion limits, and byte-bounded queue/task pages preserve blobs.",
    "Completed-response retry and reopened outcome replay preserve state and identity."
  ],
  "limitations": [
    "Memory object store only; no real S3/process kill/full Temporal boot claim.",
    "Five namespace user-data/build-ID TaskStore methods remain required issue40; FairTaskStore excluded.",
    "Single shared matching partition; dynamic routing/global distributed listing remains later scope.",
    "Max request command1800KiB, blob1MiB, page/completion limit1000, encoded response3MiB. Sticky expiry follows pinned SQL behavior (blob metadata, no storage TTL)."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingRPC",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingRPC"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingRecovery"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerMatchingBytePages",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerMatchingBytePages"
      ]
    }
  ]
}
