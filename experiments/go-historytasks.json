  "fault_schedule": "Seed execution task keys through the production writer, read pages, complete and reopen; open a successor writer then replay the stale acknowledged read.",
  "assertions": [
    "Three operations cross actual gRPC to the Go native owner.",
    "Scheduled MaxInt64 continuation uses exact strict-after cursor, including microsecond preepoch values.",
    "Completion and range completion are durable, replayable and category-isolated.",
    "Whole encoded responses fit 3MiB and continue without omission.",
    "Successor engine fences acknowledged read replay."
  ],
  "limitations": [
    "Component memory object-store proof; not process crash or real S3 acceptance.",
    "Full ExecutionStore composition, ownership routing and Temporal boot remain separate gates."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-shard",
      "filter": "TestHistoryTasksRPC",
      "exact": true,
      "expected_tests": [
        "TestHistoryTasksRPC"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerHistoryTasksRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerHistoryTasksRecovery"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerHistoryTasksBytePages",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerHistoryTasksBytePages"
      ]
    }
  ]
