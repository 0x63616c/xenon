  "fault_schedule": "Committed queue RPC proxy drops first completed DLQ enqueue response; native test stages delete then aborts journal, reopens after delete-all and fences prior owner.",
  "assertions": [
    "All legacy Queue methods cross actual RPC to Go SlateDB owner.",
    "Normal and DLQ versions guard writes and Init preserves existing metadata.",
    "Lost completed response retries exact operation identity without duplicate enqueue.",
    "Message allocation survives delete-all and reopen; replay does not recreate deleted messages.",
    "Aborted transaction publishes neither staged delete nor outcome journal.",
    "Queue replay rejects fenced owners.",
    "Near-limit page fits default gRPC response bound and continuation omits no record."
  ],
  "limitations": [
    "Memory object store; no process-crash or real S3 claim.",
    "Legacy Queue only; QueueV2 and full Temporal boot remain pending.",
    "Three pinned SQL deviations explicitly adjudicated in issue30 and contract evidence."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-shard",
      "filter": "TestQueueRPC",
      "exact": true,
      "expected_tests": [
        "TestQueueRPC"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestQueueByteBoundedPagination",
      "exact": true,
      "expected_tests": [
        "TestQueueByteBoundedPagination"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestQueueRemoteCancellation",
      "exact": true,
      "expected_tests": [
        "TestQueueRemoteCancellation"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerQueueRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerQueueRecovery"
      ]
    }
  ]
}
