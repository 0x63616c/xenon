{
  "schema": 1,
  "name": "visibility-movement",
  "backend": "memory",
  "timeout_seconds_per_command": 60,
  "required_tool_prefixes": {
    "go": "go version go1.27.1 "
  },
  "inputs": [
    "go.mod",
    "go.sum",
    "scripts/prove.py",
    "scripts/ministack-runtime.py",
    "cmd/xenon-sdk-probe/main.go",
    "cmd/xenon-visibility-probe/main.go",
    "cmd/xenon-visibility-probe/barrier.go",
    "cmd/xenon-visibility-probe/barrier_test.go",
    "proof/visibility/frozen.json",
    "proof/acceptance/full-profile.json",
    "test/scenarios/ministack/visibility-movement.json",
    "proof/visibility/movement.md"
  ],
  "fault_schedule": "Real filesystem cursor release control, wrong token and missing release deadline. Runtime movement itself is not executed by this component proof.",
  "assertions": [
    "First-page barrier cannot resume until exact controller token; missing release is bounded."
  ],
  "limitations": [
    "No live stack execution in component control.",
    "Runtime scenario must execute separately against real S3 emulator owners."
  ],
  "commands": [
    {
      "runner": "go-test-visibility-barrier",
      "filter": "TestVisibilityMovementBarrier",
      "exact": true,
      "expected_tests": [
        "TestVisibilityMovementBarrier/release",
        "TestVisibilityMovementBarrier/wrong_token",
        "TestVisibilityMovementBarrier/deadline",
        "TestVisibilityMovementBarrier"
      ]
    }
  ]
}
