{
  "schema": 1,
  "name": "go-cluster",
  "backend": "memory",
  "timeout_seconds_per_command": 600,
  "required_tool_prefixes": {
    "rustc": "rustc 1.94.0 ",
    "go": "go version go1.27.1 "
  },
  "inputs": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "go.mod",
    "go.sum",
    "proto/xenon/v1/persistence.proto",
    "gen/xenon/v1/persistence.pb.go",
    "gen/xenon/v1/persistence_grpc.pb.go",
    "internal/adapter/shard.go",
    "internal/adapter/shard_integration_test.go",
    "proof/shard/case.json",
    "scripts/generate-proto.sh",
    "scripts/test-shard.sh",
    "tools/protoc.json",
    "scripts/install-protoc.py",
    "scripts/test_prove.py",
    "tools/slatedb-native.json",
    "scripts/build-go-node.py",
    "internal/node/shard.go",
    "internal/node/shard_test.go",
    "cmd/xenon-go-node/main.go",
    "proof/go-shard/case.json",
    "proto/xenon/v1/metadata.proto",
    "gen/xenon/v1/metadata.pb.go",
    "gen/xenon/v1/metadata_grpc.pb.go",
    "internal/node/journal.go",
    "internal/node/metadata.go",
    "internal/adapter/metadata.go",
    "internal/adapter/metadata_integration_test.go",
    "proof/namespace/case.json",
    "internal/node/metadata_test.go",
    "proto/xenon/v1/cluster.proto",
    "gen/xenon/v1/cluster.pb.go",
    "gen/xenon/v1/cluster_grpc.pb.go",
    "internal/node/cluster.go",
    "internal/node/cluster_test.go",
    "internal/adapter/cluster.go",
    "internal/adapter/cluster_test.go",
    "proof/go-cluster/case.json",
    "proof/go-cluster/README.md"
  ],
  "fault_schedule": "Fixed clock and IDs from proof/go-cluster/case.json; simultaneous expected-version CAS; replay after newer mutation/reopen; competing owner fences replay. Existing shard/namespace registered faults retained.",
  "assertions": [
    "Exact Go ShardStore payload/encoding and callback semantics cross real gRPC into Rust SlateDB.",
    "Lost completed response retries same operation identity and does not overwrite intervening state.",
    "Shard and outcomes reopen together; replay cannot bypass writer fencing.",
    "Missing Update and range mismatch preserve distinct typed errors.",
    "Stalled durability quarantines; caller timeout and admission are bounded.",
    "All integration fixtures execute only the freshly built Go owner; no Rust server fallback.",
    "All namespace MetadataStore methods execute across real gRPC into the Go SlateDB owner.",
    "Namespace rename/version/name indexes and durable outcomes update atomically; replay cannot cross operation families.",
    "Near-limit namespace records paginate within the default gRPC receive limit and replay identically.",
    "Cluster CAS has exactly one winner and reopens with same durable result.",
    "Replay cannot extend membership expiry or bypass fencing.",
    "Membership filters preserve strict time boundaries, optional filter presence and paging.",
    "Real gRPC and upstream manager receive byte-bounded pages and typed errors."
  ],
  "limitations": [
    "Single logical partition; no directory/routing/full Temporal boot.",
    "Memory object store only; no real-S3 or process-crash recovery claim.",
    "Native registered proof; pinned container orchestration remains a separate shipping gate."
  ],
  "commands": [
    {
      "runner": "go-node-build"
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerRecoveryAndReplay",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerRecoveryAndReplay"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerFencedReplay",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerFencedReplay"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerNativeTimeout",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerNativeTimeout"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerPausedAdmission",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerPausedAdmission"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestShardRPC",
      "exact": true,
      "expected_tests": [
        "TestShardRPC"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestShardTransportBoundsAndTypes",
      "exact": true,
      "expected_tests": [
        "TestShardTransportBoundsAndTypes",
        "TestShardTransportBoundsAndTypes/Unavailable",
        "TestShardTransportBoundsAndTypes/ResourceExhausted",
        "TestShardTransportBoundsAndTypes/InvalidArgument",
        "TestShardTransportBoundsAndTypes/OK"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestNamespaceRPC",
      "exact": true,
      "expected_tests": [
        "TestNamespaceRPC"
      ]
    },
    {
      "runner": "go-test-shard",
      "filter": "TestNamespaceByteBoundedPagination",
      "exact": true,
      "expected_tests": [
        "TestNamespaceByteBoundedPagination"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerNamespaceRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerNamespaceRecovery"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerClusterRecovery",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerClusterRecovery"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerClusterMembership",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerClusterMembership"
      ]
    },
    {
      "runner": "go-test-node",
      "filter": "TestGoOwnerClusterRPC",
      "exact": true,
      "expected_tests": [
        "TestGoOwnerClusterRPC"
      ]
    }
  ]
}
