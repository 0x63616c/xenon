{
  "log": {
    "stdout": true,
    "level": "info"
  },
  "persistence": {
    "defaultStore": "xenon-default",
    "visibilityStore": "xenon-visibility",
    "numHistoryShards": 4,
    "datastores": {
      "xenon-default": {
        "customDatastore": {
          "name": "xenon",
          "options": {
            "address": "127.0.0.1:17935",
            "matchingPartition": "matching",
            "globalPartition": "global",
            "historyPartitions": [
              "history-0",
              "history-1",
              "history-2",
              "history-3"
            ]
          }
        }
      },
      "xenon-visibility": {
        "customDatastore": {
          "name": "xenon",
          "options": {
            "address": "127.0.0.1:17935",
            "index": "xenon-visibility",
            "schema_partition": "global"
          }
        }
      }
    }
  },
  "global": {
    "membership": {
      "maxJoinDuration": "30s",
      "broadcastAddress": "127.0.0.1"
    }
  },
  "services": {
    "frontend": {
      "rpc": {
        "grpcPort": 18233,
        "membershipPort": 18300,
        "bindOnIP": "0.0.0.0"
      }
    },
    "history": {
      "rpc": {
        "grpcPort": 18234,
        "membershipPort": 18301,
        "bindOnIP": "0.0.0.0"
      }
    },
    "matching": {
      "rpc": {
        "grpcPort": 18235,
        "membershipPort": 18302,
        "bindOnIP": "0.0.0.0"
      }
    },
    "worker": {
      "rpc": {
        "grpcPort": 18239,
        "membershipPort": 18303,
        "bindOnIP": "0.0.0.0"
      }
    }
  },
  "clusterMetadata": {
    "enableGlobalNamespace": false,
    "failoverVersionIncrement": 10,
    "masterClusterName": "active",
    "currentClusterName": "active",
    "clusterInformation": {
      "active": {
        "enabled": true,
        "initialFailoverVersion": 1,
        "rpcName": "frontend",
        "rpcAddress": "127.0.0.1:17233"
      }
    }
  },
  "dcRedirectionPolicy": {
    "policy": "noop"
  },
  "archival": {
    "history": {
      "state": "disabled",
      "enableRead": false
    },
    "visibility": {
      "state": "disabled",
      "enableRead": false
    }
  }
}