+// activitySignalFallback declares every numbered signal this activity may send
+// to its fallback execution, including signals after the first WithStart.
+// The original sequence and actions are never changed; IDs remain optional.
+func activitySignalFallback(sequence *kitchensink.ClientSequence) *kitchensink.WorkflowInput {
+	input := &kitchensink.WorkflowInput{}
+	var visit func(*kitchensink.ClientActionSet)
+	visit = func(set *kitchensink.ClientActionSet) {
+		for _, action := range set.GetActions() {
+			if signal := action.GetDoSignal().GetDoSignalActions(); signal != nil && signal.SignalId > 0 && !slices.Contains(input.OptionalSignalIds, signal.SignalId) {
+				input.OptionalSignalIds = append(input.OptionalSignalIds, signal.SignalId)
+			}
+			if nested := action.GetNestedActions(); nested != nil {
+				visit(nested)
+			}
+		}
+	}
+	for _, set := range sequence.GetActionSets() {
+		visit(set)
+	}
+	return input
 }
 
