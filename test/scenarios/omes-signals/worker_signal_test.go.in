package kitchensink

import (
	"errors"
	"fmt"
	"github.com/temporalio/omes/clioptions"
	pb "github.com/temporalio/omes/loadgen/kitchensink"
	common "go.temporal.io/api/common/v1"
	"go.temporal.io/sdk/testsuite"
	"go.temporal.io/sdk/workflow"
	"google.golang.org/protobuf/proto"
	"testing"
	"time"
)

// This test is injected into the exact pinned Go worker package in a disposable
// source checkout. It executes the real workflow, not a model of its predicate.
func TestXenonSignalMetadataContract(t *testing.T) {
	for _, tc := range []struct {
		name      string
		input     *pb.WorkflowInput
		completes bool
	}{
		{"nil_input", nil, false},
		{"empty_input", &pb.WorkflowInput{}, false},
		{"declared_ids", &pb.WorkflowInput{ExpectedSignalIds: []int32{1, 2}}, true},
	} {
		t.Run(tc.name, func(t *testing.T) {
			var suite testsuite.WorkflowTestSuite
			env := suite.NewTestWorkflowEnvironment()
			env.SetDataConverter(clioptions.OmesDataConverter())
			env.RegisterWorkflow(KitchenSinkWorkflow)
			env.RegisterDelayedCallback(func() {
				env.SignalWorkflow("do_actions_signal", &pb.DoSignal_DoSignalActions{SignalId: 1, Variant: &pb.DoSignal_DoSignalActions_DoActions{DoActions: &pb.ActionSet{}}})
				result := &pb.ReturnResultAction{ReturnThis: &common.Payload{Metadata: map[string][]byte{"encoding": []byte("binary/null")}}}
				actions := &pb.ActionSet{Actions: []*pb.Action{{Variant: &pb.Action_ReturnResult{ReturnResult: result}}}}
				env.SignalWorkflow("do_actions_signal", &pb.DoSignal_DoSignalActions{SignalId: 2, Variant: &pb.DoSignal_DoSignalActions_DoActionsInMain{DoActionsInMain: actions}})
			}, time.Second)
			env.RegisterDelayedCallback(func() { env.CancelWorkflow() }, 2*time.Second)
			env.ExecuteWorkflow(KitchenSinkWorkflow, tc.input)
			if !env.IsWorkflowCompleted() {
				t.Fatal("test did not terminate")
			}
			err := env.GetWorkflowError()
			if tc.completes && err != nil {
				t.Fatal(err)
			}
			if !tc.completes && err == nil {
				t.Fatal("undeclared numbered return unexpectedly executed")
			}
		})
	}
}

func returnSignal(id int32, value string) *pb.DoSignal_DoSignalActions {
	result := &pb.ReturnResultAction{ReturnThis: &common.Payload{Metadata: map[string][]byte{"encoding": []byte("json/plain")}, Data: []byte(`"` + value + `"`)}}
	return &pb.DoSignal_DoSignalActions{SignalId: id, Variant: &pb.DoSignal_DoSignalActions_DoActionsInMain{DoActionsInMain: &pb.ActionSet{Actions: []*pb.Action{{Variant: &pb.Action_ReturnResult{ReturnResult: result}}}}}}
}
func TestXenonOptionalSignalContract(t *testing.T) {
	for _, delivered := range []bool{false, true} {
		t.Run(fmt.Sprint(delivered), func(t *testing.T) {
			var suite testsuite.WorkflowTestSuite
			env := suite.NewTestWorkflowEnvironment()
			env.SetDataConverter(clioptions.OmesDataConverter())
			env.RegisterWorkflow(KitchenSinkWorkflow)
			env.RegisterDelayedCallback(func() {
				if delivered {
					env.SignalWorkflow("do_actions_signal", &pb.DoSignal_DoSignalActions{SignalId: 3, Variant: &pb.DoSignal_DoSignalActions_DoActions{DoActions: &pb.ActionSet{}}})
					env.SignalWorkflow("do_actions_signal", returnSignal(3, "duplicate"))
				}
				env.SignalWorkflow("do_actions_signal", returnSignal(99, "unknown"))
				env.SignalWorkflow("do_actions_signal", returnSignal(2, "ok"))
			}, time.Second)
			env.ExecuteWorkflow(KitchenSinkWorkflow, &pb.WorkflowInput{ExpectedSignalIds: []int32{2}, OptionalSignalIds: []int32{3}})
			if err := env.GetWorkflowError(); err != nil {
				t.Fatal(err)
			}
			var result string
			if err := env.GetWorkflowResult(&result); err != nil {
				t.Fatal(err)
			}
			if result != "ok" {
				t.Fatalf("wrong result: %s", result)
			}
		})
	}
}
func TestXenonRequiredSignalStillDrains(t *testing.T) {
	var suite testsuite.WorkflowTestSuite
	env := suite.NewTestWorkflowEnvironment()
	env.SetDataConverter(clioptions.OmesDataConverter())
	env.RegisterWorkflow(KitchenSinkWorkflow)
	env.RegisterDelayedCallback(func() { env.SignalWorkflow("do_actions_signal", returnSignal(2, "ok")) }, time.Second)
	env.RegisterDelayedCallback(func() { env.CancelWorkflow() }, 2*time.Second)
	env.ExecuteWorkflow(KitchenSinkWorkflow, &pb.WorkflowInput{ExpectedSignalIds: []int32{1, 2}, OptionalSignalIds: []int32{3}})
	if env.GetWorkflowError() == nil {
		t.Fatal("missing required signal did not block")
	}
}
func TestXenonCANSignalScope(t *testing.T) {
	successor := &pb.WorkflowInput{ExpectedSignalIds: []int32{10}, OptionalSignalIds: []int32{11}}
	encoded, err := proto.Marshal(successor)
	if err != nil {
		t.Fatal(err)
	}
	argument := &common.Payload{Metadata: map[string][]byte{"encoding": []byte("binary/protobuf"), "messageType": []byte("temporal.omes.kitchen_sink.WorkflowInput")}, Data: encoded}
	can := &pb.ContinueAsNewAction{Arguments: []*common.Payload{argument}}
	signal := &pb.DoSignal_DoSignalActions{SignalId: 1, Variant: &pb.DoSignal_DoSignalActions_DoActionsInMain{DoActionsInMain: &pb.ActionSet{Actions: []*pb.Action{{Variant: &pb.Action_ContinueAsNew{ContinueAsNew: can}}}}}}
	var suite testsuite.WorkflowTestSuite
	env := suite.NewTestWorkflowEnvironment()
	env.SetDataConverter(clioptions.OmesDataConverter())
	env.RegisterWorkflow(KitchenSinkWorkflow)
	env.RegisterDelayedCallback(func() { env.SignalWorkflow("do_actions_signal", signal) }, time.Second)
	env.ExecuteWorkflow(KitchenSinkWorkflow, &pb.WorkflowInput{ExpectedSignalIds: []int32{1}, OptionalSignalIds: []int32{2}})
	var continuation *workflow.ContinueAsNewError
	if !errors.As(env.GetWorkflowError(), &continuation) {
		t.Fatal(env.GetWorkflowError())
	}
	var next pb.WorkflowInput
	if err := clioptions.OmesDataConverter().FromPayloads(continuation.Input, &next); err != nil {
		t.Fatal(err)
	}
	if !proto.Equal(successor, &next) {
		t.Fatal("CAN successor metadata changed")
	}
	env = suite.NewTestWorkflowEnvironment()
	env.SetDataConverter(clioptions.OmesDataConverter())
	env.RegisterWorkflow(KitchenSinkWorkflow)
	env.RegisterDelayedCallback(func() {
		env.SignalWorkflow("do_actions_signal", returnSignal(2, "late-old-run"))
		env.SignalWorkflow("do_actions_signal", returnSignal(10, "ok"))
	}, time.Second)
	env.ExecuteWorkflow(KitchenSinkWorkflow, &next)
	if err := env.GetWorkflowError(); err != nil {
		t.Fatal(err)
	}
	var result string
	if err := env.GetWorkflowResult(&result); err != nil {
		t.Fatal(err)
	}
	if result != "ok" {
		t.Fatal("late prior-run signal accepted")
	}
}

func TestXenonOptionalDeliveryExecutes(t *testing.T) {
 var suite testsuite.WorkflowTestSuite
 env:=suite.NewTestWorkflowEnvironment();env.SetDataConverter(clioptions.OmesDataConverter());env.RegisterWorkflow(KitchenSinkWorkflow)
 env.RegisterDelayedCallback(func(){env.SignalWorkflow("do_actions_signal",returnSignal(3,"optional-executed"))},time.Second)
 env.RegisterDelayedCallback(func(){env.CancelWorkflow()},2*time.Second)
 env.ExecuteWorkflow(KitchenSinkWorkflow,&pb.WorkflowInput{OptionalSignalIds:[]int32{3}})
 if err:=env.GetWorkflowError();err!=nil{t.Fatal(err)}
 var result string;if err:=env.GetWorkflowResult(&result);err!=nil{t.Fatal(err)};if result!="optional-executed"{t.Fatal(result)}
}
