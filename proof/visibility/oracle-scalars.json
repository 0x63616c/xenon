  {
    "name": "keyword-{}",
    "sql": "jsonb_build_object('contains', ('{}'::jsonb->'KeywordList01') @> jsonb_build_array('x'), 'not_contains', NOT (('{}'::jsonb->'KeywordList01') @> jsonb_build_array('x')))",
    "expected": {
      "contains": null,
      "not_contains": null
    }
  },
  {
    "name": "keyword-{\"KeywordList01\":null}",
    "sql": "jsonb_build_object('contains', ('{\"KeywordList01\":null}'::jsonb->'KeywordList01') @> jsonb_build_array('x'), 'not_contains', NOT (('{\"KeywordList01\":null}'::jsonb->'KeywordList01') @> jsonb_build_array('x')))",
    "expected": {
      "contains": false,
      "not_contains": true
    }
  },
  {
    "name": "keyword-{\"KeywordList01\":[]}",
    "sql": "jsonb_build_object('contains', ('{\"KeywordList01\":[]}'::jsonb->'KeywordList01') @> jsonb_build_array('x'), 'not_contains', NOT (('{\"KeywordList01\":[]}'::jsonb->'KeywordList01') @> jsonb_build_array('x')))",
    "expected": {
      "contains": false,
      "not_contains": true
    }
  },
  {
    "name": "keyword-{\"KeywordList01\":[\"x\",\"x\",\"\u00e9\"]}",
    "sql": "jsonb_build_object('contains', ('{\"KeywordList01\":[\"x\",\"x\",\"\u00e9\"]}'::jsonb->'KeywordList01') @> jsonb_build_array('x'), 'not_contains', NOT (('{\"KeywordList01\":[\"x\",\"x\",\"\u00e9\"]}'::jsonb->'KeywordList01') @> jsonb_build_array('x')))",
    "expected": {
      "contains": true,
      "not_contains": false
    }
  },
  {
    "name": "collation-C",
    "sql": "(SELECT jsonb_agg(s ORDER BY s COLLATE \"C\") FROM (VALUES ('\u00e9'),('z'),('A'),('a')) t(s))",
    "expected": [
      "A",
      "a",
      "z",
      "\u00e9"
    ]
  },
  {
    "name": "group-null",
    "sql": "(SELECT jsonb_agg(jsonb_build_object('value',s,'count',n) ORDER BY s COLLATE \"C\" NULLS FIRST) FROM (SELECT s,count(*) n FROM (VALUES (NULL::text), (NULL::text),('a')) t(s) GROUP BY s) g)",
    "expected": [
      {
        "value": null,
        "count": 2
      },
      {
        "value": "a",
        "count": 1
      }
    ]
  }
