[
  {
    "name": "decimal-1.234565",
    "sql": "to_jsonb((1.234565::decimal(20,5))::text)",
    "expected": "1.23457"
  },
  {
    "name": "decimal--1.234565",
    "sql": "to_jsonb((-1.234565::decimal(20,5))::text)",
    "expected": "-1.23457"
  },
  {
    "name": "decimal-999999999999999.999994",
    "sql": "to_jsonb((999999999999999.999994::decimal(20,5))::text)",
    "expected": "999999999999999.99999"
  },
  {
    "name": "decimal-positive-overflow",
    "sql": "to_jsonb((999999999999999.999995::decimal(20,5))::text)",
    "expected": {
      "error": "22003"
    }
  },
  {
    "name": "decimal-negative-overflow",
    "sql": "to_jsonb((-999999999999999.999995::decimal(20,5))::text)",
    "expected": {
      "error": "22003"
    }
  },
  {
    "name": "decimal-raw-versus-generated",
    "sql": "jsonb_build_object('raw', ('{\"Double01\":1.234565}'::jsonb)->'Double01','generated',((('{\"Double01\":1.234565}'::jsonb)->'Double01')::decimal)::decimal(20,5), 'equal_original', ((('{\"Double01\":1.234565}'::jsonb)->'Double01')::decimal)::decimal(20,5)=1.234565, 'equal_rounded', ((('{\"Double01\":1.234565}'::jsonb)->'Double01')::decimal)::decimal(20,5)=1.23457)",
    "expected": {
      "raw": 1.234565,
      "generated": 1.23457,
      "equal_original": false,
      "equal_rounded": true
    }
  },
